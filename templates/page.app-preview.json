            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_f3V6KW": {
          "type": "question",
          "settings": {
            "question": "Do I have to own the balm to use the app?",
            "answer": "<p>Not at all—you can join the waitlist for the app alone. But pairing the app with the balm transforms a daily swipe into a powerful ritual. Lip-softening meets soul-softening.</p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        },
        "question_UxLXar": {
          "type": "question",
          "settings": {
            "question": "Is the app free?",
            "answer": "<p>SayLa’s core daily affirmation experience is 100% free when you join the waitlist. (We’ll share details on premium features down the road—like advanced customization and themed packs.)</p>",
            "icon": "none",
            "icon_width": 24,
            "mobile_icon_width": 20
          }
        }
      },
