{%- if product.featured_media != blank -%}
  {%- assign show_secondary_image = show_secondary_image | default: settings.product_card_show_secondary_image, allow_false: true -%}
  {%- assign loading_strategy = 'lazy' -%}
  {%- assign fetch_priority = 'auto' -%}
  {%- if position == 1 -%}
    {%- assign loading_strategy = 'eager' -%}
    {%- assign fetch_priority = 'high' -%}
  {%- elsif position == 2 or position == 3 -%}
    {%- assign loading_strategy = 'eager' -%}
  {%- endif -%}
  <a href="{{ product.url }}" class="product-card__media" data-instant>
    {%- if product.media.size > 0 -%}
      {%- assign main_media_loading_strategy = loading_strategy -%}
      {%- capture main_image_classes -%}product-card__image product-card__image--primary {% if settings.product_card_image_aspect_ratio contains 'crop' %}size-full object-cover{% endif %} aspect-{{ settings.product_card_image_aspect_ratio | split: '_' | first }}{%- endcapture -%}
      {%- assign card_max_width = 600 -%}
      {%- if product.featured_media.width < card_max_width -%}
        {%- assign card_max_width = product.featured_media.width -%}
      {%- endif -%}
      {{- product.featured_media | image_url: width: card_max_width | image_tag: loading: main_media_loading_strategy, fetchpriority: fetch_priority, decoding: 'async', sizes: sizes, widths: '200,300,400,600', class: main_image_classes -}}
      {%- if show_secondary_image and product.media.size > 1 -%}
        {%- assign next_media = product.media[product.featured_media.position] | default: product.media[1] -%}
        {%- if next_media != blank -%}
          {%- assign card_max_width = 600 -%}
          {%- if next_media.width < card_max_width -%}
            {%- assign card_max_width = next_media.width -%}
          {%- endif -%}
          {{- next_media | image_url: width: card_max_width | image_tag: class: 'product-card__image product-card__image--secondary', loading: 'lazy', fetchpriority: 'low', decoding: 'async', sizes: sizes, widths: '200,300,400,600', draggable: 'false' -}}
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {{- 'image' | placeholder_svg_tag: 'w-full zoom-image group-hover:zoom' -}}
    {%- endif -%}
  </a>
{%- endif -%}