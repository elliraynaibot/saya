        "accordion_PTArdi": {
          "type": "accordion",
          "settings": {
            "title": "Product Features",
            "content": "<ul><li>USDA-certified organic lip balm base</li><li>Key ingredients: organic beeswax, coconut oil, sunflower oil, and vitamin E</li><li>Naturally flavored—no synthetic additives or dyes</li><li>Euro-style tube printed with the affirmation theme: <em>Resilient</em></li><li>Made in the USA</li><li>Shelf life: 18 months</li></ul>",
