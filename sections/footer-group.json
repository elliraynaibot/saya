      "settings": {
        "color_scheme": "scheme-4",
        "liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What makes this lip balm {{ product.metafields.custom.affirmation_theme }}?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"The {{ product.metafields.custom.affirmation_theme }} theme is centered on truth that helps you remember your value and come back to what is steady and grounding each time you apply the balm.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How does this lip balm work with the SayLa App?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Each tube includes a QR code that unlocks your full affirmation and personalized encouragement inside the SayLa App. The app learns what you need most, such as peace, confidence, or resilience, and pairs those prompts with your daily lip balm ritual.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is this lip balm organic and clean?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Our formula is made with USDA-certified organic ingredients and contains no parabens, petroleum, synthetic fragrances, or fillers.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What does the flavor smell and feel like?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Each balm is designed with a soft, comforting glide and a gentle aroma that matches the flavor, creating a small moment of ease every time you apply it.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is this safe for sensitive lips or allergies?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our formula is gentle and suitable for most skin types. If you have known sensitivities to natural oils, beeswax, or essential oils, we recommend reviewing the ingredient list and doing a small patch test before regular use.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does one tube typically last?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"With normal daily use, most customers find that one tube lasts about six to eight weeks. The exact timing depends on how often you apply it throughout the day.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is this a good gift?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes. Each balm arrives thoughtfully designed and beautifully packaged, making it a meaningful gift for women who appreciate intentional, purpose-driven self-care.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is SayLa faith-based or for everyone?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"SayLa is inspired by timeless, faith-rooted truths but is created to be welcoming and accessible to anyone. Our affirmations are written to be universally true, grounding, and encouraging, without being preachy or exclusive.\"\n      }      \n    }\n  ]\n}\n</script><script>\nwindow.addEventListener('load', function() {\n  setTimeout(function() {\n    // This loads the Google script file\n    var script = document.createElement('script');\n    script.async = true;\n    script.src = \"https://www.googletagmanager.com/gtag/js?id=GT-5R8SKPXL\";\n    document.head.appendChild(script);\n\n    // This starts the Google tracking\n    window.dataLayer = window.dataLayer || [];\n    function gtag(){dataLayer.push(arguments);}\n    gtag('js', new Date());\n    gtag('config', 'GT-5R8SKPXL');\n    \n    console.log('Google Tag Manager loaded after 3s delay');\n  }, 3000); \n});\n</script>",
